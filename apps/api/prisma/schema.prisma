// Prisma schema for FitApp
// Postgres + pgvector (vector extension enabled for the future AI coach, Phase 3).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // Direct (non-pooled) connection used for migrations (`prisma migrate`).
  // On Supabase set this to the port-5432 URL; DATABASE_URL is the pooler (6543).
  // Locally both point to the same Postgres (see docker-compose).
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

/// One fitness exercise, imported from the exercises-dataset (data/exercises.json).
model Exercise {
  id               String   @id
  name             String
  category         String
  bodyPart         String   @map("body_part")
  equipment        String
  target           String
  muscleGroup      String   @map("muscle_group")
  secondaryMuscles String[] @map("secondary_muscles")
  instructions     Json
  instructionSteps Json     @map("instruction_steps")
  image            String
  gifUrl           String   @map("gif_url")
  mediaId          String   @map("media_id")
  attribution      String
  createdAt        DateTime @default(now()) @map("created_at")

  routineExercises RoutineExercise[]
  setLogs          SetLog[]

  @@index([bodyPart])
  @@index([equipment])
  @@index([target])
  @@map("exercises")
}

// ---------------------------------------------------------------------------
// Phase 2 — accounts, generated routines and workout logging
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  /// null for accounts that only sign in with Google
  passwordHash String?  @map("password_hash")
  /// Google's stable subject id; set when the account is linked to Google
  googleId     String?  @unique @map("google_id")
  avatarUrl    String?  @map("avatar_url")
  name         String
  /// client | admin. Se comprueba leyendo esta columna en cada petición, nunca
  /// desde el JWT: con tokens de 30 días y sin revocación, degradar a un admin
  /// le dejaría el rol hasta que caducara el suyo.
  role         String   @default("client")
  createdAt    DateTime @default(now()) @map("created_at")

  routines     Routine[]
  sessions     WorkoutSession[]
  subscription Subscription?
  payments     Payment[]

  @@map("users")
}

/// A training plan produced by the generator (or edited afterwards).
model Routine {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  name        String
  /// strength | hypertrophy | endurance | fatloss
  goal        String
  /// beginner | intermediate | advanced
  level       String
  daysPerWeek Int      @map("days_per_week")
  /// split template id, e.g. "fullbody" | "upperlower" | "ppl"
  split       String
  /// equipment the user said they have (empty = everything)
  equipment   String[]
  /// "home" | "gym": dónde se entrena el plan. El generador lo decide y hasta
  /// ahora se perdía al guardar, que es lo que obligaba a deducirlo del equipo.
  place       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  days     RoutineDay[]
  sessions WorkoutSession[]

  @@index([userId])
  @@map("routines")
}

model RoutineDay {
  id        String   @id @default(cuid())
  routineId String   @map("routine_id")
  position  Int
  /// label key translated in the UI, e.g. "push" | "fullbody-a"
  label     String
  /// muscle group ids shown as badges
  focus     String[]

  routine   Routine           @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercises RoutineExercise[]
  sessions  WorkoutSession[]

  @@index([routineId])
  @@map("routine_days")
}

model RoutineExercise {
  id         String @id @default(cuid())
  dayId      String @map("day_id")
  exerciseId String @map("exercise_id")
  position   Int
  sets       Int
  repsMin    Int    @map("reps_min")
  repsMax    Int    @map("reps_max")
  restSec    Int    @map("rest_sec")
  /// muscle group slot this exercise was picked for
  slot       String

  day      RoutineDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exercise Exercise   @relation(fields: [exerciseId], references: [id])

  @@index([dayId])
  @@map("routine_exercises")
}

/// One training session. Free sessions (no routine) are allowed.
model WorkoutSession {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  routineId  String?   @map("routine_id")
  dayId      String?   @map("day_id")
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  notes      String?

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  routine Routine?    @relation(fields: [routineId], references: [id], onDelete: SetNull)
  day     RoutineDay? @relation(fields: [dayId], references: [id], onDelete: SetNull)
  sets    SetLog[]

  @@index([userId, startedAt])
  @@map("workout_sessions")
}

model SetLog {
  id         String @id @default(cuid())
  sessionId  String @map("session_id")
  exerciseId String @map("exercise_id")
  setNumber  Int    @map("set_number")
  reps       Int
  /// kilograms; 0 for body-weight work
  weight     Float  @default(0)

  session  WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise       @relation(fields: [exerciseId], references: [id])

  @@index([sessionId])
  @@index([exerciseId])
  @@map("set_logs")
}

// ---------------------------------------------------------------------------
// Phase 2b — subscriptions and payments
// ---------------------------------------------------------------------------

/// A subscription tier. Seeded from PLANS in src/billing/plans.ts, not editable
/// from the app.
model Plan {
  code       String   @id
  name       String
  /// Price in cents of `currency` (Bs 49.00 -> 4900). 0 for the free plan.
  priceCents Int      @map("price_cents")
  /// ISO 4217. Bolivianos for the QR/transfer flow; a Merchant of Record such
  /// as Polar settles in USD, hence per-row and not a global constant.
  currency   String   @default("BOB")
  /// Days one paid period lasts. 0 = never expires (the free plan).
  periodDays Int      @map("period_days")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  subscriptions Subscription[]
  payments      Payment[]

  @@map("plans")
}

/// The user's current subscription. No row at all means the free plan, so
/// existing accounts need no backfill.
model Subscription {
  id        String    @id @default(cuid())
  userId    String    @unique @map("user_id")
  planCode  String    @map("plan_code")
  /// active | expired | cancelled
  status    String
  /// Provider that paid for the period in force ("manual-qr" | "polar").
  provider  String
  startedAt DateTime  @default(now()) @map("started_at")
  /// null only while the plan never expires.
  expiresAt DateTime? @map("expires_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planCode], references: [code])

  @@index([status, expiresAt])
  @@map("subscriptions")
}

/// One payment attempt. Append-only: rows are transitioned, never deleted.
model Payment {
  id          String    @id @default(cuid())
  /// null cuando la cuenta se borró: el pago es un registro contable y no
  /// puede desaparecer con ella, así que la relación se anula en vez de
  /// arrastrarlo (el borrado de cuenta anonimiza, no destruye).
  userId      String?   @map("user_id")
  planCode    String    @map("plan_code")
  /// "manual-qr" | "polar"
  provider    String
  /// Short code the payer quotes in the transfer, e.g. "FIT-7QK4M2".
  reference   String    @unique
  /// Provider-side id (a Polar order). null for manual-qr. Unique because it
  /// is what makes webhook delivery idempotent.
  externalId  String?   @unique @map("external_id")
  /// pending | paid | failed | expired
  status      String
  amountCents Int       @map("amount_cents")
  currency    String    @default("BOB")
  /// Provider payload: checkout url, transfer instructions, admin note.
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  /// Unclaimed manual payments go stale so the admin queue stays short.
  expiresAt   DateTime? @map("expires_at")
  paidAt      DateTime? @map("paid_at")
  /// Email of the admin who confirmed a manual payment (audit trail).
  confirmedBy String?   @map("confirmed_by")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  plan Plan  @relation(fields: [planCode], references: [code])

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

/// Quién puede entrar mientras dura la beta cerrada. El correo es la clave
/// porque la invitación existe antes que la cuenta: se invita a una dirección,
/// no a un usuario.
model AllowedEmail {
  email String @id
  /// Correo del admin que dio el acceso, o null si vino de la semilla del
  /// entorno. Es rastro histórico: no se sigue al borrar esa cuenta.
  invitedBy String?  @map("invited_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("allowed_emails")
}
