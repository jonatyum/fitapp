# Production image for the FitApp API on Render.
# Unlike the dev Dockerfile, this one bakes the dataset into the image
# (cloned from GitHub) instead of relying on a local volume mount, and runs
# the server without file-watching.
FROM node:20-alpine

WORKDIR /app

# git is needed to fetch the exercises dataset (media + exercises.json).
RUN apk add --no-cache git

# Clone the dataset once at build time (shallow). Serves as both the media
# root (/media/*) and the seed source. Pinned to the public repo.
RUN git clone --depth 1 https://github.com/hasaneyldrm/exercises-dataset.git /dataset \
  && rm -rf /dataset/.git

ENV DATASET_ROOT=/dataset
ENV DATASET_PATH=/dataset/data/exercises.json

# Install dependencies first (better layer caching). --include=dev is required:
# the server runs via tsx (a devDependency), so dev deps must NOT be pruned,
# even if the platform sets NODE_ENV=production during the build.
COPY package.json ./
RUN npm install --include=dev

# Prisma schema + source.
COPY prisma ./prisma
COPY tsconfig.json ./
COPY src ./src

RUN npx prisma generate

# Set production mode only for the running server, after deps are installed.
ENV NODE_ENV=production

# Render injects PORT; the server reads it. Documented default:
EXPOSE 3001

# On boot: apply any pending versioned migration, seed once (idempotent), then
# serve. `migrate deploy` only ever runs the SQL in prisma/migrations — it never
# drops or rewrites anything on its own, and it refuses to start the server if a
# migration fails, so a bad deploy stops instead of serving a wrong schema.
#
# It connects through DIRECT_URL (the datasource's `directUrl`), not the pooler.
#
# A database created earlier with `prisma db push` has no _prisma_migrations
# table and must be baselined ONCE before the first deploy with this image,
# or the initial migration will try to recreate existing tables and fail.
# See DEPLOY.md → "Bases de datos que ya existen (baselining)".
CMD ["sh", "-c", "npx prisma migrate deploy && npm run seed && npm start"]
