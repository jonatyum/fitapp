# Copy to `.env` (same folder as docker-compose.yml) and fill in.
# Everything here is optional — the app runs without it.

# Enables "Sign in with Google". See README → "Inicio de sesión con Google".
# Only the client ID is needed; there is no client secret in this flow.
GOOGLE_CLIENT_ID=

# --- Rate limiting (API) -----------------------------------------------------
# All optional: leaving them empty keeps the defaults shown below.
# The window accepts a number of milliseconds or a phrase like "1 minute".

# Strict budget for /auth/login, /auth/register and /auth/google, per IP and
# per endpoint. Answers 429 { "error": "rate_limited" } once exceeded.
AUTH_RATE_LIMIT_MAX=8
AUTH_RATE_LIMIT_WINDOW=1 minute

# Laxer budget for every other endpoint (shared bucket per IP).
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# Static media under /media/* — one exercise list pulls dozens of images,
# so it gets its own, much larger budget. /health is never limited.
MEDIA_RATE_LIMIT_MAX=1000
MEDIA_RATE_LIMIT_WINDOW=1 minute

# The plan generator (/routines/generate, /routines/alternatives). It runs
# without an account so the activation path works before signing up, and each
# call is a handful of catalogue queries — hence its own, tighter bucket.
PLAN_RATE_LIMIT_MAX=30
PLAN_RATE_LIMIT_WINDOW=1 minute

# Payment-provider callbacks under /billing/webhook/* — their own bucket so a
# provider retrying does not eat into anyone's browsing budget.
WEBHOOK_RATE_LIMIT_MAX=120
WEBHOOK_RATE_LIMIT_WINDOW=1 minute

# Behind a reverse proxy (Render, a CDN) every request arrives from the proxy's
# IP and the limits above would collapse into one shared bucket. Set this so
# the client IP is read from X-Forwarded-For instead.
# "false" (default) | "true" | a comma-separated IP/CIDR allow-list.
TRUST_PROXY=false

# --- Subscriptions (API) -----------------------------------------------------

# Bootstrap admins: comma-separated emails of existing accounts, promoted to
# the `admin` role on every boot. It is only the seed — from then on the role
# column decides, and admins are managed from the panel. Never demotes, so
# clearing this cannot lock everyone out. Empty = nobody (fail closed).
ADMIN_EMAILS=

# Hours a bank transfer stays claimable before the admin queue drops it.
PAYMENT_PENDING_HOURS=72

# --- Payment provider: manual-qr (QR Simple / transfer, 0% commission) -------
# The active provider. It is enabled only when QR_ACCOUNT_NUMBER and QR_CONTACT
# are both set — otherwise the plans screen hides it rather than telling users
# to pay into an empty account.
QR_BANK_NAME=
QR_ACCOUNT_NAME=
QR_ACCOUNT_NUMBER=
# Absolute URL of the QR Simple image. Optional: without it the screen shows
# only the account details.
QR_IMAGE_URL=
# Where the payer sends the receipt, e.g. a WhatsApp number.
QR_CONTACT=

# --- Payment provider: polar (Polar.sh, PREPARED BUT OFF) -------------------
# Merchant of Record for card payments from abroad; settles in USD. The code is
# in src/billing/polar.ts and stays disabled until all three of ACCESS_TOKEN,
# WEBHOOK_SECRET and PRODUCT_ID_PRO are set. Do not enable without first
# verifying the two API calls against Polar's current docs — they have never
# run against a live account.
#
# Webhook endpoint to register in the Polar dashboard:
#   https://<tu-api>.onrender.com/billing/webhook/polar
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID_PRO=
# Where Polar returns the browser after checkout, e.g.
# https://<usuario>.github.io/<repo>/
POLAR_SUCCESS_URL=
# Override only to point at a Polar sandbox.
POLAR_API_URL=
